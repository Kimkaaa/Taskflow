generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskVisibility {
  PRIVATE
  GROUP
  PUBLIC
}

model User {
  id        String   @id
  nickname  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks        Task[]
  groupMembers GroupMember[]
  ownedGroups  Group[]       @relation("GroupOwner")
}

model Task {
  id         String         @id @default(cuid())
  userId     String
  groupId    String?
  visibility TaskVisibility @default(PRIVATE)

  title       String
  description String
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Restrict)

  todos    TaskTodo[]
  taskTags TaskTag[]

  @@index([userId, visibility])
  @@index([groupId, visibility])
  @@index([visibility])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
}

model TaskTodo {
  id        String   @id @default(cuid())
  taskId    String
  content   String
  isDone    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  taskTags TaskTag[]

  @@unique([name])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

model Group {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members GroupMember[]
  invite  GroupInvite?
  tasks   Task[]

  @@index([ownerId])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model GroupInvite {
  id        String   @id @default(cuid())
  groupId   String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}
